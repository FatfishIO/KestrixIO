# GEMINI_API_KEY: Required for server-side Gemini AI API calls via packages/llm-gateway.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Drizzle ORM (packages/db).
DATABASE_URL="postgresql://kestrix:password@localhost:5432/kestrix_db"

# REDIS_URL: Redis or Valkey connection string for BullMQ worker queue and SSE pub/sub.
REDIS_URL="redis://localhost:6379"

# MINIO_ENDPOINT: S3/MinIO object storage endpoint for raw SARIF/CycloneDX artifacts.
MINIO_ENDPOINT="http://localhost:9000"
